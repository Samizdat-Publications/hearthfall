  {
   "id": "hud_all_spells",
   "params": {
    "seed": 7,
    "level": "continents",
    "tribes": 2,
    "camera": "default"
   },
   "steps": [
    {
     "setCamera": {
      "zoom": 0.12
     }
    },
    {
     "eval": "['bolt','call','hornets','raise_land','lightning','flatten','quake','volcano','veil','ward','beguile','whirlwind','mire','erode','firerain','wraith'].forEach((spell) => __game.command({ tribe: -1, type: 'grantCharges', args: { tribe: 0, spell, n: 1 } }))"
    },
    {
     "step": 2
    },
    {
     "assert": "document.querySelectorAll('[data-hud=spellbar] .spell').length === 16 && document.querySelector('[data-hud=spellbar]').getBoundingClientRect().height > 90"
    }
   ],
   "kind": "hud",
   "coverage": {
    "green": [
     0.03,
     0.95
    ]
   },
   "minHud": 6
  }
 ]
