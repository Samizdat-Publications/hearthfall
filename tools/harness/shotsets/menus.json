{
  "$comment": "BACKLOG 81: menu screens at 1280x720 (main with the title illustration, settings, skirmish setup, campaign; BACKLOG 12 the map editor; BACKLOG 19 the replay bar over a replay of a forced win; BACKLOG 21 the records screen after a forced win). Part of npm run qa as shot-menus.",
  "shots": [
    { "id": "menu_main", "params": { "menu": "1" }, "steps": [{ "step": 2 }, { "assert": "document.querySelector('[data-hud=menu-main] .menu-art') !== null && document.querySelector('[data-hud=menu-main] .menu-art').complete" }], "kind": "menu" },
    { "id": "menu_settings", "params": { "menu": "1" }, "steps": [{ "step": 2 }, { "eval": "document.querySelector('[data-ui=settings]').click()" }, { "step": 2 }, { "assert": "document.querySelector('[data-hud=menu-settings]') !== null" }], "kind": "menu" },
    { "id": "menu_setup", "params": { "menu": "1" }, "steps": [{ "step": 2 }, { "eval": "document.querySelector('[data-ui=skirmish]').click()" }, { "step": 2 }, { "assert": "document.querySelector('[data-hud=menu-setup]') !== null" }], "kind": "menu" },
    { "id": "menu_campaign", "params": { "menu": "1" }, "steps": [{ "step": 2 }, { "eval": "document.querySelector('[data-ui=campaign]').click()" }, { "step": 2 }, { "assert": "document.querySelector('[data-hud=menu-campaign]') !== null" }], "kind": "menu" },
    { "id": "replay_bar", "params": { "menu": "1" }, "steps": [{ "step": 2 }, { "eval": "document.querySelector('[data-ui=skirmish]').click()" }, { "step": 2 }, { "eval": "document.querySelector('[data-ui=start]').click()" }, { "step": 300 }, { "eval": "window.__game.forceWin()" }, { "step": 2 }, { "eval": "document.querySelector('[data-ui=end-replay]').click()" }, { "step": 1 }, { "eval": "window.__game.replaySeek(150)" }, { "step": 2 }, { "assert": "document.querySelector('[data-hud=replay]') !== null && window.__game.replay().tick >= 150 && window.__game.screen() === 'none'" }], "kind": "menu" },
    { "id": "menu_records", "params": { "menu": "1" }, "steps": [{ "step": 2 }, { "eval": "document.querySelector('[data-ui=skirmish]').click()" }, { "step": 2 }, { "eval": "document.querySelector('[data-ui=start]').click()" }, { "step": 300 }, { "eval": "window.__game.forceWin()" }, { "step": 2 }, { "eval": "document.querySelector('[data-ui=main-menu]').click()" }, { "step": 2 }, { "eval": "document.querySelector('[data-ui=records]').click()" }, { "step": 2 }, { "assert": "document.querySelector('[data-hud=menu-records]') !== null && document.querySelector('[data-ui=achievement-first_light]').className.includes('earned')" }], "kind": "menu" },
    { "id": "menu_editor", "params": { "menu": "1" }, "steps": [{ "step": 2 }, { "eval": "document.querySelector('[data-ui=editor]').click()" }, { "step": 1 }, { "eval": "const g = window.__game; const t = (x) => document.querySelector('[data-ui=editor-tool-' + x + ']').click(); t('sea'); g.editorAt(50, 26); t('hill'); g.editorAt(60, 62); t('reliquary'); g.editorAt(48, 48); t('tree'); g.editorAt(40, 40); g.editorAt(58, 56)" }, { "step": 2 }, { "assert": "document.querySelector('[data-hud=editor]') !== null && window.__game.editor().draft.setup.some((s) => s.site)" }], "kind": "menu" }
  ]
}
