{
  "$comment": "Campaign levels (M9, S3 levels 17 to 22): worship sites (placeholder meshes) and the level HUD, booted with ?campaign=<level>. Not part of npm run qa (making-of and review only).",
  "shots": [
    {
      "id": "narrow_water_shrine",
      "params": {
        "campaign": "narrow_water",
        "camera": "default"
      },
      "steps": [
        {
          "step": 20
        },
        {
          "eval": "const s = __game.getSummary().sites[0]; __game.setCamera({ x: s.at[0] - 3, z: s.at[1] + 2, zoom: 0.12, yaw: 0.5 });"
        },
        {
          "step": 2
        },
        {
          "assert": "__game.getSummary().sites.length === 1"
        }
      ],
      "kind": "world",
      "coverage": {
        "green": [
          0.02,
          0.99
        ]
      }
    },
    {
