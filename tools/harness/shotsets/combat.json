{
 "$comment": "M6 combat VFX: each shot steps its scenario until the event fires, then captures while the effect is alive (expectVfx). Scenario shots pass reveal=1 (BACKLOG 3): they check spell and combat visuals, not the fog of war.",
 "shots": [
  {
   "id": "fireball",
   "params": {
    "scenario": "combat_firecaller_splash_from_range",
    "camera": "default",
    "reveal": "1"
   },
   "steps": [
    {
     "setCamera": {
      "x": 23,
      "z": 32,
      "zoom": 0.1,
      "yaw": 0.7
     }
    },
    {
     "eval": "window.__hit = false; for (let k = 0; k < 900 && !window.__hit; k++) { __game.step(1); const s = __game.getSummary(); window.__hit = s.lastEvents.some((e) => e.type === 'fireball' && e.tick >= s.tick - 1); }"
    },
    {
     "step": 4
    },
    {
     "assert": "window.__hit === true"
    }
   ],
   "kind": "world",
   "coverage": {
    "green": [
     0.02,
     0.99
    ]
   },
   "expectVfx": 1
  },
  {
