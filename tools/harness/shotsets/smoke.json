    },
    {
     "assert": "__game.getSelection().length === 6"
    },
    {
     "eval": "window.__p0 = __game.getSelection().map((id) => __game.unitPos(id)); __game.orderAt(1100, 420)"
    },
    {
     "step": 60
    },
    {
     "assert": "__game.getSelection().filter((id, k) => { const p = __game.unitPos(id); const q = window.__p0[k]; return Math.hypot(p[0] - q[0], p[1] - q[1]) > 1.5; }).length >= 5"
    }
