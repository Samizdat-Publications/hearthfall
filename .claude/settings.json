{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(py *)",
      "Bash(pip *)",
      "Bash(git init*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git restore *)",
      "Bash(git revert *)",
      "Bash(git stash *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Edit(/**)",
      "Bash(test *)",
      "Bash(taskkill /PID *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Read(./.env)",
      "Read(**/.env)"
    ]
  },
  "autoCompactWindow": 300000,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "2700000"
  }
}
