# Copy to .env (never commit .env). Paste your own key values; Claude Code never reads this file.
OPENAI_API_KEY=
MESHY_API_KEY=
TRIPO_API_KEY=
PIXELLAB_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

BLENDER_EXE=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# VisionQA (OpenAI Decisions API). Stays off until the probe succeeds.
VISIONQA_PROVIDER=off
VISIONQA_DETAIL=low
VISIONQA_DAILY_USD=1.00
VISIONQA_TOTAL_USD=8.00
VISIONQA_MOVES=off

# Asset budgets for the first 24 hours (USD)
BUDGET_MESHY_USD=15
BUDGET_TRIPO_USD=5
BUDGET_GEMINI_USD=5
BUDGET_ELEVENLABS_USD=5
BUDGET_PIXELLAB_USD=0
BUDGET_TOTAL_USD=30
