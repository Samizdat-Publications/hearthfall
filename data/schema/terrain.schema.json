{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "presets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$comment": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "basePeriod": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "octaves": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "persistence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "landFraction": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 0.95
          },
          "peakiness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "terrace": {
            "type": "object",
            "properties": {
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "flat": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.9
              },
              "rampSlope": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "step",
              "flat",
              "rampSlope"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "basePeriod",
          "octaves",
          "persistence",
          "landFraction",
          "peakiness"
        ],
        "additionalProperties": false
      }
    },
    "trees": {
      "type": "object",
      "properties": {
        "densityByBand": {
          "type": "object",
          "properties": {
            "shore": {
              "type": "number"
            },
            "lowland": {
              "type": "number"
            },
            "grass": {
              "type": "number"
            },
            "highland": {
              "type": "number"
            },
            "rock": {
              "type": "number"
            },
            "peak": {
              "type": "number"
            }
          },
          "required": [
            "shore",
            "lowland",
            "grass",
            "highland",
            "rock",
            "peak"
          ],
          "additionalProperties": false
        },
        "clusterPeriod": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "clusterThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "clearRadiusAroundHearth": {
          "type": "number",
          "minimum": 0
        },
        "maxSlope": {
          "type": "number",
          "minimum": 0
        },
        "hearthGrove": {
          "type": "object",
          "properties": {
            "inner": {
              "type": "number",
              "minimum": 0
            },
            "outer": {
              "type": "number",
              "minimum": 0
            },
            "density": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "inner",
            "outer",
            "density"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "densityByBand",
        "clusterPeriod",
        "clusterThreshold",
        "clearRadiusAroundHearth",
        "maxSlope"
      ],
      "additionalProperties": false
    },
    "hearth": {
      "type": "object",
      "properties": {
        "flatRadius": {
          "type": "number",
          "minimum": 0
        },
        "minHeightAboveSea": {
          "type": "number",
          "minimum": 0
        },
        "maxSiteRange": {
          "type": "number",
          "minimum": 0
        },
        "minSpacingFracOfSize": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      },
      "required": [
        "flatRadius",
        "minHeightAboveSea",
        "maxSiteRange",
        "minSpacingFracOfSize"
      ],
      "additionalProperties": false
    },
    "wild": {
      "type": "object",
      "properties": {
        "distance": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "distance"
      ],
      "additionalProperties": false
    },
    "rocks": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "perHearth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "distance": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "scatterPerThousandLand": {
          "type": "number",
          "minimum": 0
        },
        "clearTreesRadius": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "perHearth",
        "distance",
        "scatterPerThousandLand",
        "clearTreesRadius"
      ],
      "additionalProperties": false
    },
    "maxRerolls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "gen": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "shoreGap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "treeMinAboveSea": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "treeDensityScale": {
          "type": "number",
          "minimum": 0
        },
        "treeJitterMin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "treeJitterSpan": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "placeTries": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "hearthCandidateStride": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "rockSpacing": {
          "type": "number",
          "minimum": 0
        },
        "rockHearthExtra": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "shoreGap",
        "treeMinAboveSea",
        "treeDensityScale",
        "treeJitterMin",
        "treeJitterSpan",
        "placeTries",
        "hearthCandidateStride",
        "rockSpacing",
        "rockHearthExtra"
      ],
      "additionalProperties": false
    },
    "ops": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "buildableAboveSea": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "erodeFloorDrownDepths": {
          "type": "number",
          "minimum": 0
        },
        "flattenPlateau": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99
        },
        "ridgeTaper": {
          "type": "number",
          "minimum": 0
        },
        "craterVentRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "craterVentDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scarCrackAbove": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scarCrack": {
          "type": "number",
          "minimum": 0
        },
        "scarBase": {
          "type": "number",
          "minimum": 0
        },
        "scarNoise": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "buildableAboveSea",
        "erodeFloorDrownDepths",
        "flattenPlateau",
        "ridgeTaper",
        "craterVentRadius",
        "craterVentDepth",
        "scarCrackAbove",
        "scarCrack",
        "scarBase",
        "scarNoise"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "presets",
    "trees",
    "hearth",
    "wild",
    "maxRerolls"
  ],
  "additionalProperties": false
}
