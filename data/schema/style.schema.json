{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "styleVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "palette": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      }
    },
    "lighting": {
      "type": "object",
      "properties": {
        "keyColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "keyIntensity": {
          "type": "number",
          "minimum": 0
        },
        "skyTop": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "skyHorizon": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "fogColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "keyColor",
        "keyIntensity",
        "skyTop",
        "skyHorizon",
        "fogColor"
      ],
      "additionalProperties": false
    },
    "direction": {
      "type": "object",
      "properties": {
        "primaryRef": {
          "type": "string"
        },
        "lightingRef": {
          "type": "string"
        },
        "chosen": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "primaryRef",
        "lightingRef",
        "chosen",
        "notes"
      ],
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "pixelScale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "paletteLevels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "ditherStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "detailNoise": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "detailCellsPerUnit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hearthLight": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "intensity": {
              "type": "number",
              "minimum": 0
            },
            "distance": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "color",
            "intensity",
            "distance"
          ],
          "additionalProperties": false
        },
        "ambientIntensity": {
          "type": "number",
          "minimum": 0
        },
        "space": {
          "type": "object",
          "properties": {
            "$comment": {
              "type": "string"
            },
            "top": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "horizon": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "stars": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "rim": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "top",
            "horizon",
            "stars",
            "rim"
          ],
          "additionalProperties": false
        },
        "foamStrokes": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "pixelScale",
        "paletteLevels",
        "ditherStrength",
        "detailNoise",
        "detailCellsPerUnit",
        "hearthLight",
        "ambientIntensity"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "cues": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "cue": {
                "type": "string",
                "minLength": 1
              },
              "maxPerTick": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "where": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            },
            "required": [
              "cue"
            ],
            "additionalProperties": false
          }
        },
        "alias": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "cues"
      ],
      "additionalProperties": false
    },
    "promptStyleSuffix": {
      "type": "string"
    },
    "promptNegative": {
      "type": "string"
    },
    "triBudgets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "required": [
    "styleVersion",
    "palette",
    "lighting",
    "promptStyleSuffix",
    "promptNegative",
    "triBudgets"
  ],
  "additionalProperties": false
}
