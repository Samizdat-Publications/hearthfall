{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "personalities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$comment": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "tribeColorDefault": {
            "type": "string",
            "enum": [
              "azure",
              "crimson",
              "amber",
              "jade"
            ]
          },
          "economyTargetPop": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "armyMix": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "aggression": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "firstAttackMinute": {
            "type": "number",
            "minimum": 0
          },
          "spellPrefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "scouting": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "towerAffinity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "trait": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "towerFromPopShare": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "shades": {
            "type": "object",
            "properties": {
              "$comment": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "fromMinute": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "count",
              "fromMinute"
            ],
            "additionalProperties": false
          },
          "forge": {
            "type": "object",
            "properties": {
              "$comment": {
                "type": "string"
              },
              "plan": {
                "type": "string",
                "enum": [
                  "moat",
                  "wall",
                  "flatten"
                ]
              },
              "ring": {
                "type": "number",
                "minimum": 0
              },
              "strokes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "perDecision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "plan",
              "ring",
              "strokes",
              "perDecision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "tribeColorDefault",
          "economyTargetPop",
          "armyMix",
          "aggression",
          "firstAttackMinute",
          "spellPrefs",
          "scouting",
          "towerAffinity"
        ],
        "additionalProperties": false
      }
    },
    "difficulties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$comment": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "reactionSeconds": {
            "type": "number",
            "minimum": 0
          },
          "decisionNoise": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mapHack": {
            "type": "boolean"
          },
          "resourceMultiplier": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "reactionSeconds",
          "decisionNoise",
          "resourceMultiplier"
        ],
        "additionalProperties": false
      }
    },
    "shared": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "threatRadius": {
          "type": "number",
          "minimum": 0
        },
        "scoutRadius": {
          "type": "number",
          "minimum": 0
        },
        "defendRadius": {
          "type": "number",
          "minimum": 0
        },
        "waveBase": {
          "type": "number",
          "minimum": 0
        },
        "waveAggressionSpan": {
          "type": "number",
          "minimum": 0
        },
        "keepShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "keepMin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "keepUnderThreat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mixedHoldMinutes": {
          "type": "number",
          "minimum": 0
        },
        "attackScoreBase": {
          "type": "number"
        },
        "attackScoreAggression": {
          "type": "number"
        },
        "attackScoreSurplus": {
          "type": "number"
        },
        "castReachSlack": {
          "type": "number",
          "minimum": 0
        },
        "worshipKeepSettlers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "focusBoost": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "threatRadius",
        "scoutRadius",
        "defendRadius",
        "waveBase",
        "waveAggressionSpan",
        "keepShare",
        "keepMin",
        "keepUnderThreat",
        "mixedHoldMinutes",
        "attackScoreBase",
        "attackScoreAggression",
        "attackScoreSurplus",
        "castReachSlack"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "personalities",
    "difficulties"
  ],
  "additionalProperties": false
}
