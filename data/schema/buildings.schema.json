{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "$comment": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "footprint": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "wood": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stone": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "wood": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "upgradeWood": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "upgradeWoodAtDoor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "capacity": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "supply": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "breedSeconds": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "level",
                "capacity",
                "supply",
                "breedSeconds"
              ],
              "additionalProperties": false
            }
          },
          "garrison": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rangeBonus": {
            "type": "number"
          },
          "trains": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "queueMax": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "respawnPoint": {
            "type": "boolean"
          },
          "placement": {
            "type": "string",
            "enum": [
              "shore"
            ]
          },
          "makes": {
            "type": "object",
            "properties": {
              "unit": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "max": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "seconds": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "unit",
              "max",
              "seconds"
            ],
            "additionalProperties": false
          },
          "buildable": {
            "type": "boolean"
          },
          "hp": {
            "type": "number",
            "minimum": 0
          },
          "destructible": {
            "type": "boolean"
          },
          "rebuildable": {
            "type": "boolean"
          },
          "milestone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "footprint",
          "hp"
        ],
        "additionalProperties": false
      }
    },
    "construction": {
      "type": "object",
      "properties": {
        "flattenToAverage": {
          "type": "boolean"
        },
        "workersPerSite": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "buildSecondsPerWood": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "flattenToAverage",
        "workersPerSite",
        "buildSecondsPerWood"
      ],
      "additionalProperties": false
    },
    "trees": {
      "type": "object",
      "properties": {
        "maxWood": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "regrowSecondsPerWood": {
          "type": "number",
          "minimum": 0
        },
        "regrowFromStumpSeconds": {
          "type": "number",
          "minimum": 0
        },
        "chopSecondsPerWood": {
          "type": "number",
          "minimum": 0
        },
        "spread": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "chancePerMinute": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "enabled",
            "chancePerMinute"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "maxWood",
        "regrowSecondsPerWood",
        "regrowFromStumpSeconds",
        "chopSecondsPerWood",
        "spread"
      ],
      "additionalProperties": false
    },
    "rocks": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "maxStone": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 255
        },
        "mineSecondsPerStone": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "maxStone",
        "mineSecondsPerStone"
      ],
      "additionalProperties": false
    },
    "worship": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "shrinePrayerSeconds": {
          "type": "number",
          "minimum": 0
        },
        "missingWorshipperSpeedFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "decayPerSecond": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "$comment": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "worshippers": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "prayerSeconds": {
                "type": "number",
                "minimum": 0
              },
              "uses": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "sinks": {
                "type": "boolean"
              },
              "shaperOnly": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "worshippers",
              "uses",
              "sinks"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "shrinePrayerSeconds",
        "missingWorshipperSpeedFactor"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "buildings",
    "construction",
    "trees",
    "worship"
  ],
  "additionalProperties": false
}
