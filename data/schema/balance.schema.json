{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "sim": {
      "type": "object",
      "properties": {
        "tickHz": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "hashEverySeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "tickHz",
        "hashEverySeconds"
      ],
      "additionalProperties": false
    },
    "terrain": {
      "type": "object",
      "properties": {
        "defaultSize": {
          "type": "integer",
          "minimum": 64,
          "maximum": 512
        },
        "heightMax": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "heightUnitsPerWorldUnit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "seaLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generatorRange": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "bands": {
          "type": "object",
          "properties": {
            "shore": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lowland": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "grass": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "highland": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "rock": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "peak": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "shore",
            "lowland",
            "grass",
            "highland",
            "rock",
            "peak"
          ],
          "additionalProperties": false
        },
        "maxWalkSlope": {
          "type": "number",
          "minimum": 0
        },
        "maxBuildSlope": {
          "type": "number",
          "minimum": 0
        },
        "maxBuildRange": {
          "type": "number",
          "minimum": 0
        },
        "drownDepthHeightUnits": {
          "type": "number",
          "minimum": 0
        },
        "skirmishRequiresConnectedLand": {
          "type": "boolean"
        }
      },
      "required": [
        "defaultSize",
        "heightMax",
        "heightUnitsPerWorldUnit",
        "seaLevel",
        "generatorRange",
        "bands",
        "maxWalkSlope",
        "maxBuildSlope",
        "maxBuildRange",
        "drownDepthHeightUnits",
        "skirmishRequiresConnectedLand"
      ],
      "additionalProperties": false
    },
    "movement": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "separationRadius": {
          "type": "number",
          "minimum": 0
        },
        "separationStrength": {
          "type": "number",
          "minimum": 0
        },
        "waypointRadius": {
          "type": "number",
          "minimum": 0
        },
        "arriveRadius": {
          "type": "number",
          "minimum": 0
        },
        "crowdArriveRadius": {
          "type": "number",
          "minimum": 0
        },
        "repathSeconds": {
          "type": "number",
          "minimum": 0
        },
        "giveUpSeconds": {
          "type": "number",
          "minimum": 0
        },
        "pathBudgetPerTick": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxExpandPerSearch": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "groupFlowMinUnits": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "flowLookaheadCost": {
          "type": "number",
          "minimum": 0
        },
        "sightRadius": {
          "type": "number",
          "minimum": 0
        },
        "progressEpsilon": {
          "type": "number",
          "minimum": 0
        },
        "overlapNudge": {
          "type": "number",
          "minimum": 0
        },
        "separationScale": {
          "type": "number",
          "minimum": 0
        },
        "snapRadius": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxFlowBuildsPerTick": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "flowCacheSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "separationRadius",
        "separationStrength",
        "waypointRadius",
        "arriveRadius",
        "crowdArriveRadius",
        "repathSeconds",
        "giveUpSeconds",
        "pathBudgetPerTick",
        "maxExpandPerSearch",
        "groupFlowMinUnits",
        "flowLookaheadCost",
        "sightRadius",
        "progressEpsilon",
        "overlapNudge",
        "separationScale",
        "snapRadius",
        "maxFlowBuildsPerTick",
        "flowCacheSize"
      ],
      "additionalProperties": false
    },
    "economy": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "decideEverySeconds": {
          "type": "number",
          "minimum": 0
        },
        "flattenStepPerWorkerSecond": {
          "type": "number",
          "minimum": 0
        },
        "flattenMaxRange": {
          "type": "number",
          "minimum": 0
        },
        "carryWood": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "startWoodPerSettler": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workRange": {
          "type": "number",
          "minimum": 0
        },
        "keepOneOccupantForBreeding": {
          "type": "boolean"
        },
        "maxOpenPlansPerTribe": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "buildingGapCells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "defaultAutoCharge": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "skirmishSpells": {
          "anyOf": [
            {
              "type": "string",
              "const": "v1"
            },
            {
              "type": "string",
              "const": "all"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          ]
        },
        "wildWanderRadius": {
          "type": "number",
          "minimum": 0
        },
        "wildWanderChancePerSecond": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "doorOffset": {
          "type": "number",
          "minimum": 0
        },
        "priorities": {
          "type": "object",
          "properties": {
            "build": {
              "type": "number",
              "minimum": 0
            },
            "upgrade": {
              "type": "number",
              "minimum": 0
            },
            "breed": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "build",
            "upgrade",
            "breed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "decideEverySeconds",
        "flattenStepPerWorkerSecond",
        "flattenMaxRange",
        "carryWood",
        "startWoodPerSettler",
        "workRange",
        "keepOneOccupantForBreeding",
        "maxOpenPlansPerTribe",
        "buildingGapCells",
        "defaultAutoCharge",
        "skirmishSpells",
        "wildWanderRadius",
        "wildWanderChancePerSecond",
        "doorOffset",
        "priorities"
      ],
      "additionalProperties": false
    },
    "breeding": {
      "type": "object",
      "properties": {
        "formula": {
          "type": "string"
        },
        "nearCapSlowdownStartPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "nearCapFactorAtCap": {
          "type": "number",
          "minimum": 1
        }
      },
      "required": [
        "formula",
        "nearCapSlowdownStartPct",
        "nearCapFactorAtCap"
      ],
      "additionalProperties": false
    },
    "combat": {
      "type": "object",
      "properties": {
        "heightRangedBonusPctPerBand": {
          "type": "number"
        },
        "stuckSeconds": {
          "type": "number",
          "minimum": 0
        },
        "knockbackTicks": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "knockbackDecay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shaperMinHpFromNonLethal": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "heightRangedBonusPctPerBand",
        "stuckSeconds",
        "knockbackTicks",
        "knockbackDecay",
        "shaperMinHpFromNonLethal"
      ],
      "additionalProperties": false
    },
    "statuses": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "panic": {
          "type": "object",
          "properties": {
            "fleeDistance": {
              "type": "number",
              "minimum": 0
            },
            "repickSeconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "fleeDistance",
            "repickSeconds"
          ],
          "additionalProperties": false
        },
        "burning": {
          "type": "object",
          "properties": {
            "damagePerSecond": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "damagePerSecond"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "panic",
        "burning"
      ],
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "properties": {
        "$comment": {
          "type": "string"
        },
        "counterTriangleMinWinPct": {
          "type": "number"
        },
        "maxPersonalityWinPct": {
          "type": "number"
        },
        "medianMatchMinutes": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "unharassedPopulationAtMinute10": {
          "type": "object",
          "properties": {
            "target": {
              "type": "number"
            },
            "tolerancePct": {
              "type": "number"
            }
          },
          "required": [
            "target",
            "tolerancePct"
          ],
          "additionalProperties": false
        },
        "maxStalematePct": {
          "type": "number"
        },
        "aiEliminatesIdleMinutes": {
          "type": "number"
        }
      },
      "required": [
        "counterTriangleMinWinPct",
        "maxPersonalityWinPct",
        "medianMatchMinutes",
        "unharassedPopulationAtMinute10",
        "maxStalematePct",
        "aiEliminatesIdleMinutes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "sim",
    "terrain",
    "movement",
    "economy",
    "breeding",
    "combat",
    "statuses",
    "gates"
  ],
  "additionalProperties": false
}
