    { "at": 18500, "expr": "level.objectivesDone == 5 && count(tribe1.boathouses) >= 1 && alive(1) && !level.lost" },
    { "at": 24500, "expr": "level.objectivesDone == 6 && site('pilgrim_crown').by != 0 && !level.won && !level.lost" },
    { "at": 30000, "expr": "level.won && level.objectivesDone == 7 && site('pilgrim_crown').by == 0 && alive(0) && invariants() == 0" }
