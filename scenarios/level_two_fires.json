{
  "id": "level_two_fires",
  "description": "Campaign level 7 is completable: an aggressive hard bot prays at the seer stone, burns the northern Hearth, holds two ley stones against the southern tribe for 90 s while it breaks both rivals under fog (bot wins about 13000).",
  "tags": [
    "fast",
    "levels"
  ],
  "level": "two_fires",
  "bots": [
    {
      "type": "opponent",
      "tribe": 0,
      "personality": "aggressive",
      "difficulty": "hard",
      "offset": 2
    }
  ],
  "runTicks": 16000,
  "assert": [
    {
      "at": 6000,
      "expr": "level.objectivesDone == 1 && !level.won && alive(1)"
    },
    {
      "at": 10000,
      "expr": "level.objectivesDone == 2 && !level.won && alive(2)"
    },
    {
      "at": 16000,
      "expr": "level.won && !alive(1) && !alive(2) && alive(0) && level.objectivesDone == 4 && invariants() == 0"
    }
  ]
}