{
  "id": "level_drowned_fords",
  "description": "Campaign level 17 is completable: the bot for the player takes and keeps the ford ward between tides, prays away the sneaky ley stones, keeps all three, burns the sneaky Hearth over the causeway, prays the southern seer away from the war tribe and breaks it.",
  "tags": [
    "levels"
  ],
  "level": "drowned_fords",
  "bots": [
    {
      "type": "opponent",
      "tribe": 0,
      "personality": "aggressive",
      "difficulty": "normal",
      "offset": 1
    }
  ],
  "runTicks": 32000,
  "assert": [
    {
      "at": 6000,
      "expr": "level.objectivesDone >= 2 && alive(1) && alive(2)"
    },
    {
      "at": 12000,
      "expr": "level.objectivesDone >= 4 && alive(1) && alive(2) && !level.won"
    },
    {
      "at": 18000,
      "expr": "level.objectivesDone >= 5 && !alive(1) && !level.won"
    },
    {
      "at": 32000,
      "expr": "level.won && !alive(1) && !alive(2) && alive(0) && level.objectivesDone == 7 && invariants() == 0"
    }
  ]
}
