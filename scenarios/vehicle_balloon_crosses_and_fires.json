    { "tick": 0, "tribe": 1, "type": "setPriorities", "args": { "build": 0, "upgrade": 0, "breed": 0 } },
    { "tick": 0, "tribe": 1, "type": "setStance", "args": { "units": "tribe1.wardens", "stance": "defensive" } },
