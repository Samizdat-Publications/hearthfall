  "assert": [
    { "at": 99, "expr": "count(tribe0.units, riding) == 2" },
    { "at": 1400, "expr": "count(tribe0.units, riding) == 2 && count(tribe0.balloons, near([44, 32], 1.5)) == 1" },
    { "at": 1400, "expr": "hp(tribe1.wardens) < 2600 && hp(tribe0.balloons) == 900 && hp(tribe0.settlers) == 1000" },
