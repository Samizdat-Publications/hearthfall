      { "shape": "rect", "at": [0, 32], "size": [12, 64], "aboveSea": -30 }
    ]
  },
  "setup": [
    { "spawn": "hearth", "tribe": 0, "at": [12, 12] },
    { "spawn": "shaper", "tribe": 0, "at": [14, 14] },
    { "spawn": "hearth", "tribe": 1, "at": [52, 52] },
    { "spawn": "shaper", "tribe": 1, "at": [50, 50] },
    { "spawn": "balloon", "tribe": 0, "at": [18, 32] },
    { "spawn": "firecaller", "tribe": 0, "at": [16, 30] },
    { "spawn": "settler", "tribe": 0, "at": [16, 34] },
    { "spawn": "warden", "tribe": 1, "at": [50, 32] }
