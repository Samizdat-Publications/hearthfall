{
  "id": "rules_conquest_last_tribe_wins",
  "description": "BACKLOG 13 (ADR-014): under the conquest rules the sim, not the app, decides the match: when the Wardens cut down the last Shaper of a Hearthless rival, tribe 0 is the winner and matchWon fires once.",
  "tags": ["fast", "rules"],
  "seed": 5,
  "map": { "generator": "flat", "size": 64, "tribes": 2 },
  "rules": "conquest",
  "setup": [
    { "spawn": "hearth", "tribe": 0, "at": [12, 32] },
    { "spawn": "shaper", "tribe": 0, "at": [14, 30] },
    { "spawn": "warden", "tribe": 0, "near": [30, 32], "count": 4 },
    { "spawn": "shaper", "tribe": 1, "at": [36, 32] }
  ],
  "commands": [
    { "tick": 1, "tribe": 0, "type": "move", "args": { "units": "tribe0.wardens", "to": [36, 32], "attack": true } }
  ],
  "runTicks": 900,
  "assert": [
    { "at": 1, "expr": "rules.winner == -1" },
    { "at": 900, "expr": "!alive(1) && rules.winner == 0 && rules.why == 'conquest' && events.count('matchWon') == 1 && invariants() == 0" }
  ]
}
