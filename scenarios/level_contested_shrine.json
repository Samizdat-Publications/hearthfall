{
  "id": "level_contested_shrine",
  "description": "Campaign level 2 is completable at a human pace: the followers are only sent after a minute and still claim the hill shrine before the rival tribe.",
  "tags": ["fast", "levels"],
  "level": "contested_shrine",
  "commands": [
    { "tick": 1200, "tribe": 0, "type": "worship", "args": { "units": "tribe0.settlers", "site": "hill_shrine" } }
  ],
  "runTicks": 2400,
  "assert": [
    { "at": 2400, "expr": "level.won && site('hill_shrine').by == 0 && !level.lost && invariants() == 0" }
  ]
}
