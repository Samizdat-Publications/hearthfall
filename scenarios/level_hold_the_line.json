  "runTicks": 6000,
  "assert": [
    { "at": 3600, "expr": "events.count('triggerFired') == 4 && events.count('raid') == 2 && !level.won" },
    { "at": 6000, "expr": "level.won && alive(0) && invariants() == 0" }
  ]
}
